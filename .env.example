# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# LINE Developers Console → your Messaging API channel
#   Basic settings   → Channel secret
#   Messaging API    → Channel access token (long-lived) → Issue
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Password for the webchat. Required in production (the app stays locked without it).
# Leave empty locally to skip the login screen.
APP_PASSWORD=

# Neon Postgres connection string. Vercel's Neon integration sets this for you.
# Leave empty locally to use an embedded local database (no setup needed).
DATABASE_URL=

# Vercel Blob (for sending images/files). Set automatically when you connect a
# Blob store to the Vercel project. Leave empty to disable attachments.
BLOB_READ_WRITE_TOKEN=

# Testing only: send LINE API calls to a mock server instead of api.line.me.
# LINE_API_BASE_URL=http://localhost:4010
